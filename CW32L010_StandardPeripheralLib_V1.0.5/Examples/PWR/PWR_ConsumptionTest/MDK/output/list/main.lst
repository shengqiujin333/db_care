N/******************************************************************************
N * type definitions ('typedef')
N ******************************************************************************/
N
N/**
N * @brief  UART Init Structure definition
N */
N
Ntypedef struct
N{
N    uint32_t UART_BaudRate;            /*!< 波特率
N                                           计算公式:
N                                            - UART_Over = 00， BaudRate = UCLK / (16 * BRRI + BRRF)
N                                            - UART_Over = 01， BaudRate = UCLK / (8 * BRRI)
N                                            - UART_Over = 10， BaudRate = UCLK / (4 * BRRI)
N                                            - UART_Over = 11， BaudRate = (256 * UCLK) / BRRI */
N
N    uint16_t UART_Over;                /*!< 采样方式
N                                           参数取值 @ref UART_Over */
N
N    uint16_t UART_Source;              /*!< 传输时钟源UCLK
N                                           参数取值 @ref UART_Source */
N
N    uint32_t UART_UclkFreq;            /*!< 传输时钟UCLK频率 Hz */
N
N    uint16_t UART_StartBit;            /*!< 起始位判定方式
N                                           参数取值 @ref UART_Start_Bit */
N
N    uint16_t UART_StopBits;            /*!< 停止位长度
N                                           参数取值 @ref UART_Stop_Bits */
N
N    uint16_t UART_Parity;              /*!< 校验方式
N                                           参数取值 @ref UART_Parity
N                                           @note 当设置为无校验时，数据字长为8位；
N                                                 当设置为有校验时，数据字长自动设置为9位 */
N
N    uint16_t UART_Mode;                /*!< 发送/接收使能
N                                           参数取值 @ref UART_Mode */
N
N    uint16_t UART_HardwareFlowControl; /*!< 硬件流控
N                                           参数取值 @ref UART_Hardware_Flow_Control */
N} UART_InitTypeDef;
N
N/**
N  * @brief  UART Clock Init Structure definition
N  */
N
Ntypedef struct
N{
N    uint16_t UART_Clock;   /*!< UART同步模式使能/失能
N                               参数取值 @ref UART_Clock */
N
N    uint16_t UART_Source;  /*!< 传输时钟源UCLK
N                               参数取值 @ref UART_Source */
N} UART_ClockInitTypeDef;
N
N/******************************************************************************
N * pre-processor symbols/macros ('#define')
