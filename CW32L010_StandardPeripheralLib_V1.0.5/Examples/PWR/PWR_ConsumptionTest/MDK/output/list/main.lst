N/**
N * @brief Retargets the C library printf function to the UART.
N *
N */
NPUTCHAR_PROTOTYPE
Xint fputc(int ch, FILE *f)
N{
N    UART_SendData_8bit(DEBUG_UARTx, (uint8_t)ch);
X    UART_SendData_8bit(((UART_TypeDef*) 0x40001000UL), (uint8_t)ch);
N
N    while (UART_GetFlagStatus(DEBUG_UARTx, UART_FLAG_TXE) == RESET);
X    while (UART_GetFlagStatus(((UART_TypeDef*) 0x40001000UL), ((uint16_t)0x0001)) == RESET);
N
N    return ch;
N}
N
Nsize_t __write(int handle, const unsigned char * buffer, size_t size)
N{
N    size_t nChars = 0;
N
N    if (buffer == 0)
N    {
N        /*
N         * This means that we should flush internal buffers.  Since we
N         * don't we just return.  (Remember, "handle" == -1 means that all
N         * handles should be flushed.)
N         */
N        return 0;
N    }
N
N
N    for (/* Empty */; size != 0; --size)
N    {
N        UART_SendData_8bit(DEBUG_UARTx, *buffer++);
X        UART_SendData_8bit(((UART_TypeDef*) 0x40001000UL), *buffer++);
N        while (UART_GetFlagStatus(DEBUG_UARTx, UART_FLAG_TXE) == RESET);
X        while (UART_GetFlagStatus(((UART_TypeDef*) 0x40001000UL), ((uint16_t)0x0001)) == RESET);
N        ++nChars;
N    }
N
N    return nChars;
N}
