N/**
N ******************************************************************************
N ** @brief  ADC配置
N *****************************************************************************/
Ntypedef struct
N{
N    uint32_t                    ADC_SampTime;        /*单通道ADC采样保持时间*/ 
N    uint32_t                    ADC_InputChannel;    /*通道选择 */       
N}ADC_ChannelTypeDef;
Ntypedef struct
N{
N    uint32_t                    ADC_ClkDiv;              /*ADC时钟分频选择*/ 
N    
N    uint32_t                    ADC_ConvertMode;         /*ADC转换模式选择*/ 
N
N    uint32_t                    ADC_SQREns;    /*ADC转换通道配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN0;         /*ADC 通道0配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN1;         /*ADC 通道1配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN2;         /*ADC 通道2配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN3;         /*ADC 通道3配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN4;         /*ADC 通道4配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN5;         /*ADC 通道5配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN6;         /*ADC 通道6配置*/
N    
N    ADC_ChannelTypeDef          ADC_IN7;         /*ADC 通道7配置*/
N            
N} ADC_InitTypeDef;
N
N/**
N ******************************************************************************
N ** @brief  ADC模拟看门狗配置
N *****************************************************************************/
Ntypedef struct
N{
N    ADC_InitTypeDef   ADC_InitStruct;    /*ADC通用初始化配置*/    
N    
N    uint32_t          ADC_WatchdogCHx;            /*ADC模拟看门狗通道*/   
N
N    uint32_t          ADC_WatchdogVth;            /*ADC模拟看门狗上超出门限*/
N
N    uint32_t          ADC_WatchdogVtl;            /*ADC模拟看门狗下超出门限*/
N    
N    uint32_t          ADC_WatchdogOverHighIrq;    /*ADC模拟看门狗上超出门限中断使能*/
N    
N    uint32_t          ADC_WatchdogUnderLowIrq;    /*ADC模拟看门狗下超出门限中断使能*/
N} ADC_WatchdogTypeDef;
N
N
N/**
N ******************************************************************************
N ** @brief  ADC中断配置
N *****************************************************************************/
Ntypedef struct
N{
N    boolean_t  ADC_WdthIrq;   /*ADC模拟看门狗上阈值中断*/
N
N    boolean_t  ADC_WdtlIrq;   /*ADC模拟看门狗下阈值中断*/
N
N    boolean_t  ADC_EosIrq;    /*ADC序列转换完成中断*/
N
N    boolean_t  ADC_EocIrq;    /*ADC单次转换完成中断*/
N} ADC_IrqTypeDef;
