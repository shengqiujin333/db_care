N
N#ifdef __cplusplus
Sextern "C" {
N#endif
N
N/* Includes ------------------------------------------------------------------*/
N#include "cw32l010.h"
N#include "system_cw32l010.h"
N/******************************************************************************
N * type definitions ('typedef')
N ******************************************************************************/
Ntypedef struct
N{
N    uint32_t IWDT_Prescaler;         /* 预分配系数，取值范围2的n次幂，n=2,3..9  */
N
N    uint32_t IWDT_OverFlowAction;    /* 溢出后的动作                           */
N
N    FunctionalState IWDT_ITState;    /* 看门狗中断状态，取值范围ENABLE或DISABLE */
N
N    uint32_t IWDT_Pause;             /* Deepsleep模式下IWDT暂停控制            */
N
N    uint32_t IWDT_ReloadValue;       /* 看门狗重载值，取值范围小于等于0x0FFF    */
N
N    uint32_t IWDT_WindowValue;       /* 窗口比较器比较值,取值范围小于等于0x0FFF  */
N} IWDT_InitTypeDef;
N/******************************************************************************
N * pre-processor symbols/macros ('#define')
N ******************************************************************************/
N#define IWDT_FREQ                                  10000UL
N
N#define IWDT_Prescaler_DIV4                        ((uint32_t)0x00000000)
N#define IWDT_Prescaler_DIV8                        ((uint32_t)0x00000001)
N#define IWDT_Prescaler_DIV16                       ((uint32_t)0x00000002)
N#define IWDT_Prescaler_DIV32                       ((uint32_t)0x00000003)
N#define IWDT_Prescaler_DIV64                       ((uint32_t)0x00000004)
N#define IWDT_Prescaler_DIV128                      ((uint32_t)0x00000005)
N#define IWDT_Prescaler_DIV256                      ((uint32_t)0x00000006)
N#define IWDT_Prescaler_DIV512                      ((uint32_t)0x00000007)
N#define IS_IWDT_PRESCALER(PRESCALER)               (((PRESCALER) == IWDT_Prescaler_DIV4)   ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV8)   ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV16)  ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV32)  ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV64)  ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV128) ||\
N                                                    ((PRESCALER) == IWDT_Prescaler_DIV512))
X#define IS_IWDT_PRESCALER(PRESCALER)               (((PRESCALER) == IWDT_Prescaler_DIV4)   ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV8)   ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV16)  ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV32)  ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV64)  ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV128) ||                                                    ((PRESCALER) == IWDT_Prescaler_DIV512))
N#define IS_IWDT_WINDOW_VALUE(VALUE)                ((VALUE) <= 0xFFF)
N#define IS_IWDT_RELOAD(COUNTER)                    ((COUNTER) <= 0xFFF)
N
N#define IWDT_5_SECS                                (IWDT_4_SECS+IWDT_1_SECS+1)
N#define IWDT_4_SECS                                255
N#define IWDT_2_SECS                                127
N#define IWDT_1_SECS                                63
N#define IWDT_0_5_SECS                              31
N#define IWDT_0_25_SECS                             15
N#define IS_IWDT_PERIOD(PERIOD)                     ((PERIOD) == IWDT_2_SECS || (PERIOD) == IWDT_1_SECS ||\
N                                                    (PERIOD) == IWDT_0_5_SECS || (PERIOD) == IWDT_0_25_SECS)
X#define IS_IWDT_PERIOD(PERIOD)                     ((PERIOD) == IWDT_2_SECS || (PERIOD) == IWDT_1_SECS ||                                                    (PERIOD) == IWDT_0_5_SECS || (PERIOD) == IWDT_0_25_SECS)
N
N#define IWDT_UNLOCK_KEY                            0x5555
N#define IWDT_LOCK_KEY                              0x6666
N#define IWDT_RUN_KEY                               0xCCCC
N#define IWDT_REFRESH_KEY                           0xAAAA
N#define IWDT_STOP_KEY1                             0x5A5A
N#define IWDT_STOP_KEY2                             0xA5A5
N
N#define IWDT_OVERFLOW_ACTION_RESET                 0
N#define IWDT_OVERFLOW_ACTION_INT                   IWDT_CR_ACTION_Msk
N#define IS_IWDT_ACTION(ACTION)                     ((ACTION) == IWDT_OVERFLOW_ACTION_RESET || \
N                                                    (ACTION) == IWDT_OVERFLOW_ACTION_INT)
X#define IS_IWDT_ACTION(ACTION)                     ((ACTION) == IWDT_OVERFLOW_ACTION_RESET ||                                                     (ACTION) == IWDT_OVERFLOW_ACTION_INT)
N#define IWDT_SLEEP_PAUSE                           IWDT_CR_PAUSE_Msk
N#define IWDT_SLEEP_CONTINUE                        0
N#define IS_IWDT_SLEEP_MODE(MODE)                   ((MODE) == IWDT_SLEEP_PAUSE || \
N                                                   (MODE) == IWDT_SLEEP_CONTINUE)
X#define IS_IWDT_SLEEP_MODE(MODE)                   ((MODE) == IWDT_SLEEP_PAUSE ||                                                    (MODE) == IWDT_SLEEP_CONTINUE)
N
N#define __IWDT_RUN()                               (CW_IWDT->KR = IWDT_RUN_KEY)
N#define __IWDT_REFRESH()                           (CW_IWDT->KR = IWDT_REFRESH_KEY)
N#define __IWDT_STOP()                              do{                              \
N                                                       CW_IWDT->KR = IWDT_STOP_KEY1;\
N                                                       CW_IWDT->KR = IWDT_STOP_KEY2;\
N                                                   } while(0)
X#define __IWDT_STOP()                              do{                                                                                     CW_IWDT->KR = IWDT_STOP_KEY1;                                                       CW_IWDT->KR = IWDT_STOP_KEY2;                                                   } while(0)
N#define __IWDT_UNLOCK()                            (CW_IWDT->KR = IWDT_UNLOCK_KEY)
N#define __IWDT_LOCK()                              (CW_IWDT->KR = IWDT_LOCK_KEY)
N
N
N/******************************************************************************
N* Global variable definitions (declared in header file with 'extern')
N******************************************************************************/
N
N
N/******************************************************************************
N* Global function prototypes
N******************************************************************************/
Nvoid IWDT_DeInit(void);
Nint IWDT_Init(IWDT_InitTypeDef *IWDT_InitStruct);
N
Nvoid IWDT_Cmd(void);
Nvoid IWDT_Refresh(void);
N
Nvoid IWDT_Unlock(void);
Nvoid IWDT_Lock(void);
Nvoid IWDT_Stop(void);
N
Nint IWDT_SetPrescaler(uint32_t WWDT_Prescaler);
Nint IWDT_SetWindowValue(uint32_t WindowValue);
Nint IWDT_SetReloadValue(uint32_t ReloadValue);
Nint IWDT_ITConfig(FunctionalState NewState);
NFlagStatus IWDT_GetFlagStatus(uint32_t StatusBit);
Nvoid IWDT_ClearOVFlag(void);
Nuint32_t IWDT_GetCounterValue(void);
Nvoid IWDT_SetPeriod(uint32_t period);
N
N#ifdef __cplusplus
S}
N#endif
N
N#endif /*__CW32L010_IWDT_H */
