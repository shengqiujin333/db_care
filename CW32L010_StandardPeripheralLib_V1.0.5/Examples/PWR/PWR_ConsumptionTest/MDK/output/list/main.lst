N#define UART_Over_4                         ((uint16_t)0x0400)
N#define UART_Over_sp                        ((uint16_t)0x0600)
N#define IS_UART_Over(Over)                  (((Over) == UART_Over_16) || \
N                                             ((Over) == UART_Over_8)  || \
N                                             ((Over) == UART_Over_4)  || \
N                                             ((Over) == UART_Over_sp))
X#define IS_UART_Over(Over)                  (((Over) == UART_Over_16) ||                                              ((Over) == UART_Over_8)  ||                                              ((Over) == UART_Over_4)  ||                                              ((Over) == UART_Over_sp))
N
N/** @defgroup UART_Source
