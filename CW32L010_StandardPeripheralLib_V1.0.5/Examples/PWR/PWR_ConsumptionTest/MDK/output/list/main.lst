N
N/**
N * @brief  LPTIM Init structure definition
N */
N
Ntypedef struct
N{
N    uint32_t LPTIM_ClockSource;
N    uint32_t LPTIM_CounterMode;
N    uint32_t LPTIM_Period;
N    uint32_t LPTIM_Prescaler;
N} LPTIM_InitTypeDef;
N
N
N/* Exported constants --------------------------------------------------------*/
N#define LPTIM_CLOCK_SOURCE_MCLK          ((uint32_t)0x00000000)
N#define LPTIM_CLOCK_SOURCE_CH1           ((uint32_t)0x00000001)
N#define IS_LPTIM_CLOCK_SOURCE(SOURCE)    (((SOURCE) == LPTIM_CLOCK_SOURCE_MCLK)  ||\
N                                         ((SOURCE) == LPTIM_CLOCK_SOURCE_CH1))
X#define IS_LPTIM_CLOCK_SOURCE(SOURCE)    (((SOURCE) == LPTIM_CLOCK_SOURCE_MCLK)  ||                                         ((SOURCE) == LPTIM_CLOCK_SOURCE_CH1))
N
N#define LPTIM_COUNTER_MODE_TIME          ((uint32_t)0x00000000)
N#define LPTIM_COUNTER_MODE_COUNT         (((uint32_t)0x00000001) << 23)
N#define IS_LPTIM_COUNTER_MODE(MODE)      (((MODE) == LPTIM_COUNTER_MODE_TIME)    ||\
N                                         ((MODE) == LPTIM_COUNTER_MODE_COUNT))
