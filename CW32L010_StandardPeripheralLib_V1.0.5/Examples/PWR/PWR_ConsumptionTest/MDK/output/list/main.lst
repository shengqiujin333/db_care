N/* =========================================================================================================================== */
N/* ================                                Interrupt Number Definition                                ================ */
N/* =========================================================================================================================== */
N
Ntypedef enum {
N/* =======================================  ARM Cortex-M0+ Specific Interrupt Numbers  ======================================= */
N  Reset_IRQn                = -15,              /*!< -15  Reset Vector, invoked on Power up and warm reset                     */
N  NonMaskableInt_IRQn       = -14,              /*!< -14  Non maskable Interrupt, cannot be stopped or preempted               */
N  HardFault_IRQn            = -13,              /*!< -13  Hard Fault, all classes of Fault                                     */
N  SVCall_IRQn               =  -5,              /*!< -5 System Service Call via SVC instruction                                */
N  PendSV_IRQn               =  -2,              /*!< -2 Pendable request for system service                                    */
N  SysTick_IRQn              =  -1,              /*!< -1 System Tick Timer                                                      */
N/* ==========================================  CW32L010 Specific Interrupt Numbers  ========================================== */
N  WDT_IRQn                  =   0,              /*!< 0  Watch Dog Timer Interrupt                                              */
N  LVD_IRQn                  =   1,              /*!< 1  Low Voltage Detect Interrupt                                           */
N  RTC_IRQn                  =   2,              /*!< 2  Real Time Clock Interrupt                                              */
N  FLASHRAM_IRQn             =   3,              /*!< 3  Flash/RAM Interrupt                                                    */
N  SYSCTRL_IRQn              =   4,              /*!< 4  SYSCTRL Interupt                                                       */
N  GPIOA_IRQn                =   5,              /*!< 5  GPIOA Interrupt                                                        */
N  GPIOB_IRQn                =   6,              /*!< 6  GPIOB Interrupt                                                        */
N  ADC_IRQn                  =  12,              /*!< 12 ADC Interrupt                                                          */
N  ATIM_IRQn                 =  13,              /*!< 13 Advanced Timer Interrupt                                               */
N  VC1_IRQn                  =  14,              /*!< 14 Voltage Comparator 1 Interrupt                                         */
N  VC2_IRQn                  =  15,              /*!< 15 Voltage Comparator 2 Interrupt                                         */
N  GTIM1_IRQn                =  16,              /*!< 16 General Timer1 Interrupt                                               */
N  LPTIM_IRQn                =  19,              /*!< 19 LPTIM Interrupt                                                        */
N  BTIM1_IRQn                =  20,              /*!< 20 Base Timer1 Interrupt                                                  */
N  BTIM2_IRQn                =  21,              /*!< 21 Base Timer2 Interrupt                                                  */
N  BTIM3_IRQn                =  22,              /*!< 22 Base Timer3 Interrupt                                                  */
N  I2C1_IRQn                 =  23,              /*!< 23 I2C1 Interrupt                                                         */
N  SPI_IRQn                  =  25,              /*!< 25 SPI Interrupt                                                          */
N  UART1_IRQn                =  27,              /*!< 27 UART1 Interrupt                                                        */
N  UART2_IRQn                =  28,              /*!< 28 UART2 Interrupt                                                        */
N  CLKFAULT_IRQn             =  31               /*!< 31 Clock Fault Interrupt                                                  */
N} IRQn_Type;
