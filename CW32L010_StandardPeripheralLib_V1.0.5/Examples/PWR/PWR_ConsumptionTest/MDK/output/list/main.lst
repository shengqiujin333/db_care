N/**
N * @brief Main function of project
N *
N * @return int
N */
Nint main(void)
N{
N    static uint8_t TestState = 0;
N    static uint32_t IsPeriphRun =0;
N    GPIO_InitTypeDef GPIO_InitStructure = {0};
N   
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV12);
X    SYSCTRL_HSI_Enable(((uint32_t)(12UL << (11UL))));
N    // 配置打印串口
N    DebugUART_Configuration(4000000);
N    printf("\r\nCW32L010 PWR TEST Example\r\n");
N    printf("SysClk=HCLK=PCLK=4MHz\r\n");
N    InitTick(4000000);    //使用sysTick
N	SysTickDelay(1000); // 提供1s时间用于测量在4MHz时，MCU内核功耗1.2mA@3.3V
N    
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV6);
X    SYSCTRL_HSI_Enable(((uint32_t)(6UL << (11UL))));
N    DebugUART_Configuration(8000000);    
N    printf("SysClk=HCLK=PCLK=8MHz\r\n");
N    InitTick(8000000);
N	SysTickDelay(1000); // 提供1s时间用于测量在8MHz时，MCU内核功耗1.5mA@3.3V
N    
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV3);
X    SYSCTRL_HSI_Enable(((uint32_t)(3UL << (11UL))));
N    DebugUART_Configuration(16000000);    
N    printf("SysClk=HCLK=PCLK=16MHz\r\n");
N    InitTick(16000000);
N	SysTickDelay(1000); // 提供1s时间用于测量在16MHz时，MCU内核功耗2.2mA@3.3V
N    
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV2);
X    SYSCTRL_HSI_Enable(((uint32_t)(2UL << (11UL))));
N    DebugUART_Configuration(24000000);    
N    printf("SysClk=HCLK=PCLK=24MHz\r\n");
N    InitTick(24000000);
N	SysTickDelay(1000); // 提供1s时间用于测量在24MHz时，MCU内核功耗2.8mA@3.3V
N    
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV1);
X    SYSCTRL_HSI_Enable(((uint32_t)(1UL << (11UL))));
N    DebugUART_Configuration(48000000);    
N    printf("SysClk=HCLK=PCLK=48MHz\r\n");
N    InitTick(48000000);
N	SysTickDelay(1000); // 提供1s时间用于测量在48MHz时，MCU内核功耗3.9mA@3.3V
N    
N    SYSCTRL_HSI_Enable(SYSCTRL_HSIOSC_DIV12);
X    SYSCTRL_HSI_Enable(((uint32_t)(12UL << (11UL))));
N    InitTick(4000000); 
N    
N    // 配置PA06中断唤醒
