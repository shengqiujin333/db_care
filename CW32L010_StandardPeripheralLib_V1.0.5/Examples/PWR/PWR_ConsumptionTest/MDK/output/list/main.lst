N
N
Ntypedef struct
N{
N    uint8_t Day;
N    uint8_t Month;
N    uint8_t Year;
N    uint8_t Week;
N} RTC_DateTypeDef;
N
Ntypedef struct
N{
N    uint8_t Second;
N    uint8_t Minute;
N    uint8_t Hour;
N    uint8_t AMPM;               // RTC_AM (0), RTC_PM(1)
N    uint8_t H24;                //RTC_HOUR24(1),RTC_HOUR12(0)
N} RTC_TimeTypeDef;
N
Ntypedef struct
N{
N    uint32_t RTC_ClockSource;
N    RTC_TimeTypeDef TimeStruct;
N    RTC_DateTypeDef DateStruct;
N
N} RTC_InitTypeDef;
N
N
Ntypedef struct
N{
N    RTC_TimeTypeDef RTC_AlarmTime;
N    uint32_t RTC_AlarmMask;            /*!<  @ref RTC_AlarmMask_Definitions */
N} RTC_AlarmTypeDef;
N
Ntypedef struct
N{
N    uint8_t AWT_ClockSource;
N    uint16_t AWT_ARRValue;
N} RTC_AWTTypeDef;
N
Ntypedef struct
N{
N    uint32_t Freq;
N    uint32_t Sign;
N    uint32_t Step;
N    uint32_t CompensationValue;
N} RTC_CalibTypeDef;
N
N#define RTC_Alarm_A                             ((uint32_t)0x00000200)
N#define RTC_Alarm_B                             ((uint32_t)0x00000400)
N#define IS_RTC_ALARM(ALARM)                     (((ALARM) == RTC_Alarm_A) || ((ALARM) == RTC_Alarm_B))
N#define IS_RTC_CMD_ALARM(ALARM)                 (((ALARM) & (RTC_Alarm_A | RTC_Alarm_B)) != (uint32_t)RESET)
N
N/** @defgroup RTC_ACCESS_TIMEOUT
N* @{
N* RTC寄存器访问最大次数，RTC_CR1->WINDOW位未检测到1，判定访问RTC寄存器失败
N*/
N#define RTC_ACCESS_MAXTIMES                     ((uint32_t)200U)
N
N/** @defgroup RTC_RTC1HZ_source
N* @{
N*/
N#define RTC_RTC1HZ_NONE                         (0UL)
N#define RTC_RTC1HZ_FROM_LSE                     (1UL << 5)
N#define RTC_RTC1HZ_FROM_PCLK                    (3UL << 5)
N
N#define IS_RTC_RTC1HZ_SOURCE(src)               (((src) == RTC_RTC1HZ_NONE) ||      \
N                                                ((src) == RTC_RTC1HZ_FROM_PCLK) || \
N                                                ((src) == RTC_RTC1HZ_FROM_LSE))
X#define IS_RTC_RTC1HZ_SOURCE(src)               (((src) == RTC_RTC1HZ_NONE) ||                                                      ((src) == RTC_RTC1HZ_FROM_PCLK) ||                                                 ((src) == RTC_RTC1HZ_FROM_LSE))
N
N#define RTC_HOUR24                              (1UL)
N#define RTC_HOUR12                              (0UL)
N#define IS_RTC_HOUR_FORMAT(fmt)                 (((fmt) == RTC_HOUR24) || ((fmt) == RTC_HOUR12))
N#define IS_RTC_HOUR12_FORMAT(fmt)               ((fmt) == RTC_HOUR12)
N
N
N/** @defgroup RTC_Interval_Value
N * @{
N */
N
N#define RTC_INTERVAL_NONE                       (0X00)
N#define RTC_INTERVAL_EVERY_0_5S                 (0x01)
N#define RTC_INTERVAL_EVERY_1S                   (0x02)
N#define RTC_INTERVAL_EVERY_1M                   (0x03)
N#define RTC_INTERVAL_EVERY_1H                   (0x04)
N#define RTC_INTERVAL_EVERY_1D                   (0x05)
N#define RTC_INTERVAL_EVERY_1MO                  (0x06)
N
N#define IS_RTC_INTERVAL_PERIOD(per)             (per < 7)
N
N/** @defgroup RTC_Clock_source
N * 000：外部晶体时钟LSE
N * 010：内置低频时钟LSI
N * 001：外部晶体时钟HSE
N * 011：内部高速时钟HSIOSC
N * @{
N */
N
N#define RTC_RTCCLK_FROM_LSE                     (0UL)
N#define RTC_RTCCLK_FROM_HSE                     (1UL << 8)
N#define RTC_RTCCLK_FROM_LSI                     (2UL << 8)
N#define RTC_RTCCLK_FROM_HSIOSC                  (3UL << 8)
N
N
N#define IS_RTC_RTCCLK_SOURCE(src)               (((src) == RTC_RTCCLK_FROM_LSE) || \
N                                                ((src) == RTC_RTCCLK_FROM_HSE) || \
N                                                ((src) == RTC_RTCCLK_FROM_LSI) || \
N                                                ((src) == RTC_RTCCLK_FROM_HSIOSC))
X#define IS_RTC_RTCCLK_SOURCE(src)               (((src) == RTC_RTCCLK_FROM_LSE) ||                                                 ((src) == RTC_RTCCLK_FROM_HSE) ||                                                 ((src) == RTC_RTCCLK_FROM_LSI) ||                                                 ((src) == RTC_RTCCLK_FROM_HSIOSC))
N
N#define RTC_IT_INTERVAL                         (1UL << 6)
N#define RTC_IT_TAMPOV                           (1UL << 4)
N#define RTC_IT_TAMP                             (1UL << 3)
N#define RTC_IT_AWTIMER                          (1UL << 2)
N#define RTC_IT_ALARMB                           (1UL << 1)
N#define RTC_IT_ALARMA                           (1UL)
N#define RTC_IT_ALL                              (RTC_IT_ALARMA|RTC_IT_ALARMB|RTC_IT_AWTIMER|RTC_IT_TAMP|RTC_IT_TAMPOV|RTC_IT_INTERVAL) 
N#define IS_RTC_GET_IT(IT)                       (((IT) == RTC_IT_INTERVAL) || \
N                                                ((IT) == RTC_IT_TAMPOV) || \
N                                                ((IT) == RTC_IT_TAMP) || \
N                                                ((IT) == RTC_IT_AWTIMER) || \
N                                                ((IT) == RTC_IT_ALARMB) || \
N                                                ((IT) == RTC_IT_ALARMA) || \
N                                                ((IT) == RTC_IT_ALL ))
X#define IS_RTC_GET_IT(IT)                       (((IT) == RTC_IT_INTERVAL) ||                                                 ((IT) == RTC_IT_TAMPOV) ||                                                 ((IT) == RTC_IT_TAMP) ||                                                 ((IT) == RTC_IT_AWTIMER) ||                                                 ((IT) == RTC_IT_ALARMB) ||                                                 ((IT) == RTC_IT_ALARMA) ||                                                 ((IT) == RTC_IT_ALL ))
N#define IS_RTC_CONFIG_IT(IT)                    ((((uint8_t)(IT) & 0x20) == 0) && \
N                                                ((uint8_t)(IT) < 0x40))
X#define IS_RTC_CONFIG_IT(IT)                    ((((uint8_t)(IT) & 0x20) == 0) &&                                                 ((uint8_t)(IT) < 0x40))
N#define IS_RTC_CLAER_IT(IT)                     ((((uint8_t)(IT) & 0x20) == 0) && \
N                                                ((uint8_t)(IT) < 0x40))
X#define IS_RTC_CLAER_IT(IT)                     ((((uint8_t)(IT) & 0x20) == 0) &&                                                 ((uint8_t)(IT) < 0x40))
N
N/** @defgroup RTC_AlarmMask_Definitions
N  * @{
N  */
N#define RTC_AlarmMask_None                      ((uint32_t)0x00000000)
N#define RTC_AlarmMask_WeekSAT                   ((uint32_t)0x40000000)
N#define RTC_AlarmMask_WeekFRI                   ((uint32_t)0x20000000)
N#define RTC_AlarmMask_WeekTHU                   ((uint32_t)0x10000000)
N#define RTC_AlarmMask_WeekWED                   ((uint32_t)0x08000000)
N#define RTC_AlarmMask_WeekTUE                   ((uint32_t)0x04000000)
N#define RTC_AlarmMask_WeekMON                   ((uint32_t)0x02000000)
N#define RTC_AlarmMask_WeekSun                   ((uint32_t)0x01000000)
N#define RTC_AlarmMask_Hours                     ((uint32_t)0x00800000)
N#define RTC_AlarmMask_Minutes                   ((uint32_t)0x00008000)
N#define RTC_AlarmMask_Seconds                   ((uint32_t)0x00000080)
N#define RTC_AlarmMask_All                       ((uint32_t)0x7F808080)
N#define IS_ALARM_MASK(MASK)                     (((MASK) & 0x807F7F7F) == (uint32_t)RESET)
N
N
N#define RTC_TamperTrigger_RisingEdge            (0UL)
N#define RTC_TamperTrigger_FallingEdge           (1UL)
N#define IS_RTC_TAMPER_TRIGGER(TRIGGER)          (((TRIGGER) == RTC_TamperTrigger_RisingEdge) || \
N                                                ((TRIGGER) == RTC_TamperTrigger_FallingEdge))
X#define IS_RTC_TAMPER_TRIGGER(TRIGGER)          (((TRIGGER) == RTC_TamperTrigger_RisingEdge) ||                                                 ((TRIGGER) == RTC_TamperTrigger_FallingEdge))
N
N
N/** @defgroup RTC_Compen_step
N  * @{
N  */
N#define RTC_RTCOUT_AS_LOW                       (0x0)
N#define RTC_RTCOUT_AS_ALARM_A                   (0x1)
N#define RTC_RTCOUT_AS_ALARM_B                   (0x2)
N#define RTC_RTCOUT_AS_AWT                       (0x3)
N
N#define IS_RTC_RTCOUT_SOURCE(src)               (src < 4)
N
N/** @defgroup RTC_TimerSrc_Value
N* @{
N*/
