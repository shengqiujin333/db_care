N#define IS_UART_CLEAR_FLAG(FLAG)            ((((FLAG) & (uint16_t)0xE001) == 0x00) && ((FLAG) != (uint16_t)0x00))
N
N#define IS_UART_BAUDRATE(BAUDRATE)          (((BAUDRATE) > 0) && ((BAUDRATE) <= 0x00B71B00))
N#define IS_UART_UCLKFREQ(UCLKFREQ)          (((UCLKFREQ) > 0) && ((UCLKFREQ) <= 0x02DC6C00))
N#define IS_UART_DATA_16BIT(DATA)            ((DATA) <= 0x1FF)
N#define IS_UART_DATA_8BIT(DATA)             ((DATA) <= 0xFF)
N#define IS_UART_ADDRESS(ADDRESS)            ((ADDRESS) <= 0xFF)
N#define IS_UART_ADDRESSMSK(ADDRESSMSK)      ((ADDRESSMSK) <= 0xFF)
N#define IS_UART_AUTORELOAD(AUTORELOAD)      ((AUTORELOAD) <= 0xFFFFFF)
N#define IS_UART_ALL_PERIPH(PERIPH)          (((PERIPH) == CW_UART1) || \
N                                             ((PERIPH) == CW_UART2))
X#define IS_UART_ALL_PERIPH(PERIPH)          (((PERIPH) == CW_UART1) ||                                              ((PERIPH) == CW_UART2))
