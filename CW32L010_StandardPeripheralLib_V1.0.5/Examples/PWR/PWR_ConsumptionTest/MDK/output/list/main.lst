N//==================================================================================
N#define HSIOSC_VALUE                               ((uint32_t)48000000)                 /*!< Value of the Internal oscillator in Hz*/
N#define HSE_VALUE                                  ((uint32_t)16000000)                 /*!< Value of the External oscillator in Hz */
N
N#define LSI_VALUE                                  ((uint32_t)32800)                    /*!< Value of the External oscillator in Hz */
N#define LSE_VALUE                                  ((uint32_t)32768)                    /*!< Value of the External oscillator in Hz */
N/* SYSCTRL CR0 --------------------------------------------------------*/
N#define SYSCTRL_KEY                                (0x5A5A0000U)
N#define SYSCTRL_KEY_MASK                           (0xFFFF0000U)
N#define SYSCTRL_KEY_MASK_INV                       (0x0000FFFFU)
N
N#define SYSCTRL_HCLK_DIV1                          (0x0UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK not divided */
N#define SYSCTRL_HCLK_DIV2                          (0x1UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 2 */
N#define SYSCTRL_HCLK_DIV4                          (0x2UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 4 */
N#define SYSCTRL_HCLK_DIV8                          (0x3UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 8 */
N#define SYSCTRL_HCLK_DIV16                         (0x4UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 16 */
N#define SYSCTRL_HCLK_DIV32                         (0x5UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 32 */
N#define SYSCTRL_HCLK_DIV64                         (0x6UL << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 64 */
N#define SYSCTRL_HCLK_DIV128                        (0x7ul << SYSCTRL_CR0_HCLKPRS_Pos)   /*!< SYSCLK divided by 128 */
N#define IS_SYSCTRL_HCLKPRS(INSTANCE)               (((INSTANCE) == SYSCTRL_HCLK_DIV1)              ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV2)               ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV4)               ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV8)               ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV16)              ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV32)              ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV64)              ||\
N                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV128))
X#define IS_SYSCTRL_HCLKPRS(INSTANCE)               (((INSTANCE) == SYSCTRL_HCLK_DIV1)              ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV2)               ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV4)               ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV8)               ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV16)              ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV32)              ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV64)              ||                                                   ((INSTANCE) == SYSCTRL_HCLK_DIV128))
N
N#define SYSCTRL_PCLK_DIV1                          (0x0UL << SYSCTRL_CR0_PCLKPRS_Pos)   /*!< HCLK not divided */
N#define SYSCTRL_PCLK_DIV2                          (0x1UL << SYSCTRL_CR0_PCLKPRS_Pos)   /*!< HCLK divided by 2 */
N#define SYSCTRL_PCLK_DIV4                          (0x2UL << SYSCTRL_CR0_PCLKPRS_Pos)   /*!< HCLK divided by 4 */
N#define SYSCTRL_PCLK_DIV8                          (0x3UL << SYSCTRL_CR0_PCLKPRS_Pos)   /*!< HCLK divided by 8 */
N#define IS_SYSCTRL_PCLKPRS(INSTANCE)               (((INSTANCE) == SYSCTRL_PCLK_DIV1)              ||\
N                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV2)               ||\
N                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV4)               ||\
N                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV8))
X#define IS_SYSCTRL_PCLKPRS(INSTANCE)               (((INSTANCE) == SYSCTRL_PCLK_DIV1)              ||                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV2)               ||                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV4)               ||                                                   ((INSTANCE) == SYSCTRL_PCLK_DIV8))
N
N#define SYSCTRL_SYSCLKSRC_HSI                      (0x00000000U)                        /*!< HSI selected as system clock */
N#define SYSCTRL_SYSCLKSRC_HSE                      (0x00000001U)                        /*!< HSE selected as system clock */
N#define SYSCTRL_SYSCLKSRC_LSI                      (0x00000003U)                        /*!< LSI selected as system clock */
N#define SYSCTRL_SYSCLKSRC_LSE                      (0x00000004U)                        /*!< LSE selected as system clock */
N#define IS_SYSCTRL_SYSCLKSRC(INSTANCE)             (((INSTANCE) == SYSCTRL_SYSCLKSRC_HSI)          ||\
N                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_HSE)           ||\
N                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_LSI)           ||\
N                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_LSE))
X#define IS_SYSCTRL_SYSCLKSRC(INSTANCE)             (((INSTANCE) == SYSCTRL_SYSCLKSRC_HSI)          ||                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_HSE)           ||                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_LSI)           ||                                                   ((INSTANCE) == SYSCTRL_SYSCLKSRC_LSE))
N
N/* SYSCTRL CR1 --------------------------------------------------------*/
N#define SYSCTRL_HSIEN                              bv0
N#define SYSCTRL_HSEEN                              bv1
N#define SYSCTRL_LSIEN                              bv3
N#define SYSCTRL_LSEEN                              bv4
N#define SYSCTRL_LSELOCKEN                          bv5
N#define SYSCTRL_LSELOCKDIS                         0x00UL
N#define IS_SYSCTRL_LSELOCK_STATUS(INSTANCE)        (((INSTANCE) == SYSCTRL_LSELOCKEN)          ||\
N                                                   ((INSTANCE) == SYSCTRL_LSELOCKDIS))
X#define IS_SYSCTRL_LSELOCK_STATUS(INSTANCE)        (((INSTANCE) == SYSCTRL_LSELOCKEN)          ||                                                   ((INSTANCE) == SYSCTRL_LSELOCKDIS))
N
N#define SYSCTRL_LSECCSEN                            bv6
N#define SYSCTRL_HSECCSEN                            bv7
N#define SYSCTRL_CLKCCSEN                            bv8
N#define IS_SYSCTRL_CCS_STATUS(INSTANCE)            (((INSTANCE) == SYSCTRL_LSECCSEN)           ||\
