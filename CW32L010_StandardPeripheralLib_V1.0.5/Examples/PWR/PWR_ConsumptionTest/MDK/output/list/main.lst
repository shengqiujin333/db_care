N#define SYSCTRL_MCO_DIV1                               (0x00U)
N#define SYSCTRL_MCO_DIV2                               ((uint8_t)(0x01U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV8                               ((uint8_t)(0x02U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV64                              ((uint8_t)(0x03U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV128                             ((uint8_t)(0x04U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV256                             ((uint8_t)(0x05U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV512                             ((uint8_t)(0x06U << SYSCTRL_MCO_DIV_Pos))
N#define SYSCTRL_MCO_DIV1024                            ((uint8_t)(0x07U << SYSCTRL_MCO_DIV_Pos))
N
N#define IS_SYSCTRL_MCO_DIV(INSTANCE)                   (((INSTANCE) == SYSCTRL_MCO_DIV1)          ||\
N                                                   ((INSTANCE) == SYSCTRL_MCO_DIV2)          ||\
N                                                   ((INSTANCE) == SYSCTRL_MCO_DIV8)          ||\
N                                                   ((INSTANCE) == SYSCTRL_MCO_DIV64)         ||\
N                                                   ((INSTANCE) == SYSCTRL_MCO_DIV128)        ||\
N                                                   ((INSTANCE) == SYSCTRL_MCO_DIV256)        ||\
